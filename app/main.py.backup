            recommendations["categories"]["seasonal"] = {
                "query": season_queries if len(season_queries) > 1 else (season_queries[0] if season_queries else f"{favorite_season} song"),
                "songs": season_songs,
                "count": len(season_songs)
            }
            print(f" Season ({favorite_season}): {len(season_songs)} songs")


        if natural_elements:
            natural_target = 10
            nature_songs: List[Dict] = []
            natural_queries: List[str] = []
            for element in natural_elements[:5]:

                query = f"{element} song"
                added = self._fetch_songs_for_query(
                    query,
                    nature_songs,
                    natural_target,
                    f" Natural Element ({element})"
                )
                if added:
                    natural_queries.append(query)
                if len(nature_songs) >= natural_target:
                    break


                if len(nature_songs) < natural_target:
                    fallback_queries = [
                        f"{element} music",
                        f"{element} sounds",
                        f"{element} ambient",
                        f"rain sounds for sleeping",
                        f"nature sounds rain",
                        f"rain and thunder sounds"
                    ]
                    for fallback_query in fallback_queries:
                        if len(nature_songs) >= natural_target:
                            break
                        added = self._fetch_songs_for_query(
                            fallback_query,
                            nature_songs,
                            natural_target,
                            f" Natural Element Fallback ({fallback_query})"
                        )
                        if added:
                            natural_queries.append(fallback_query)
                        if len(nature_songs) >= natural_target:
                            break

            recommendations["categories"]["natural_elements"] = {
                "query": natural_queries if len(natural_queries) > 1 else (natural_queries[0] if natural_queries else f"{natural_elements[0]} song"),
                "songs": nature_songs,
                "count": len(nature_songs)
            }


        if favorite_genre:
            genre_target = 10
            genre_songs: List[Dict] = []
            genre_queries = []
            existing_genre_ids: Set[str] = set()

            csv_provider = getattr(self.music_service, "_provider", None)
            if csv_provider and hasattr(csv_provider, "search_by_genres"):
                csv_terms = [genre for genre in favorite_genres if genre] or [favorite_genre]
                # Preserve input order while removing duplicates
                seen_terms: Set[str] = set()
                csv_terms = [term for term in csv_terms if not (term in seen_terms or seen_terms.add(term))]
                csv_matches = csv_provider.search_by_genres(csv_terms, max_results=genre_target)
                csv_appended = False
                for match in csv_matches or []:
                    if len(genre_songs) >= genre_target:
                        break
                    match_id = str(match.get("id") or match.get("title") or "")
                    if match_id and match_id in existing_genre_ids:
                        continue
                    genre_songs.append(match)
                    if match_id:
                        existing_genre_ids.add(match_id)
                    csv_appended = True
                if csv_appended:
                    label = ", ".join(csv_terms[:3])
                    label = label or "local_csv_catalog"
                    genre_queries.append(f"{label} (local_csv)")


            if birthplace_country:

                primary_queries = [
                    f"{birthplace_country} {favorite_genre} {nostalgia_start}s",
                    f"Bangla {favorite_genre} nostalgic {nostalgia_start}-{nostalgia_end}",
                    f"Bengali {favorite_genre} classics {nostalgia_start}",
                    f"{birthplace_country} {favorite_genre} golden oldies"
                ]

                for query in primary_queries:
                    if len(genre_songs) >= genre_target:
                        break
                    added = self._fetch_songs_for_query_with_validation(
                        query,
                        genre_songs,
                        genre_target,
                        f" Favorite Genre Region-Nostalgia ({favorite_genre} + {birthplace_country})",
                        birthplace_country
                    )
                    if added:
                        genre_queries.append(query)


            if len(genre_songs) < genre_target:
                fallback_queries = [
                    f"{favorite_genre} songs {nostalgia_start}",
                    f"classic {favorite_genre} hits {nostalgia_start}s",
                    f"best {favorite_genre} songs {nostalgia_start}-{nostalgia_end}",
                    f"{favorite_genre} nostalgic songs",
                    f"top {favorite_genre} tracks",
                    f"classic {favorite_genre} hits"
                ]

                for fallback_query in fallback_queries:
                    if len(genre_songs) >= genre_target:
                        break

                    added = 0
                    if birthplace_country:
                        added = self._fetch_songs_for_query_with_validation(
                            fallback_query,
                            genre_songs,
                            genre_target,
                            f" Favorite Genre Fallback ({fallback_query})",
                            birthplace_country
                        )
                    if not added:
                        added = self._fetch_songs_for_query(
                            fallback_query,
                            genre_songs,
                            genre_target,
                            f" Favorite Genre Fallback ({fallback_query})"
                        )
                    if added:
                        genre_queries.append(fallback_query)

            if genre_songs:
                deduped: List[Dict] = []
                seen_song_keys: Set[str] = set()
                for song in genre_songs:
                    key = str(song.get("id") or "").strip()
                    if not key:
                        title = str(song.get("title") or "").strip()
                        artist = str(song.get("artist") or "").strip()
                        key = f"{title}::{artist}" if title or artist else f"row::{len(seen_song_keys)}"
                    if key in seen_song_keys:
                        continue
                    seen_song_keys.add(key)
                    deduped.append(song)
                genre_songs = deduped

            recommendations["categories"]["favorite_genre"] = {
                "query": genre_queries if len(genre_queries) > 1 else (genre_queries[0] if genre_queries else query),
                "songs": genre_songs,
                "count": len(genre_songs)
            }
            print(f" Favorite Genre ({favorite_genre}): {len(genre_songs)} songs")


        if favorite_musician:
            musician_target = 10
            musician_songs: List[Dict] = []
            musician_queries = []


            query = f"{favorite_musician} songs"
            songs = self.music_service.search_music(query, max_results=musician_target)
            if songs:
                musician_songs.extend(songs)
                musician_queries.append(query)
                print(f" Favorite Musician ({favorite_musician}): {len(songs)} songs (primary)")


            if len(musician_songs) < musician_target:
                fallback_queries = [
                    f"{favorite_musician} music",
                    f"{favorite_musician} official",
                    f"best {favorite_musician}",
                    f"{favorite_musician} greatest hits",
                    f"{favorite_musician} playlist",
                    f"mozart classical music",
                    f"mozart piano sonatas",
                    f"mozart symphony",
                    f"best classical mozart",
                    f"mozart requiem"
                ]
                for fallback_query in fallback_queries:
                    if len(musician_songs) >= musician_target:
                        break
                    songs = self.music_service.search_music(fallback_query, max_results=musician_target - len(musician_songs))
                    if songs:
                        musician_songs.extend(songs)
                        musician_queries.append(fallback_query)
                        print(f" Favorite Musician fallback ({fallback_query}): {len(songs)} songs")

            recommendations["categories"]["favorite_musician"] = {
                "query": musician_queries if len(musician_queries) > 1 else (musician_queries[0] if musician_queries else query),
                "songs": musician_songs,
                "count": len(musician_songs)
            }
            print(f" Favorite Musician ({favorite_musician}): {len(musician_songs)} total songs")


        therapeutic_conditions = {
            "difficulty_sleeping": difficulty_sleeping,
            "trouble_remembering": trouble_remembering,
            "forgets_everyday_things": forgets_everyday_things,
            "difficulty_recalling_old_memories": difficulty_recalling_old_memories,
            "memory_worse_than_year_ago": memory_worse_than_year_ago,
            "visited_mental_health_professional": visited_mental_health
        }

        for condition_key, is_true in therapeutic_conditions.items():
            if is_true:

                condition_songs: List[Dict] = []
                condition_queries_used: List[str] = []


                for query in self.therapeutic_queries[condition_key]:
                    added = self._fetch_songs_for_query(
                        query,
                        condition_songs,
                        5,
                        f" {condition_key.replace('_', ' ').title()} ({query})"
                    )
                    if added:
                        condition_queries_used.append(query)
                    if len(condition_songs) >= 5:
                        break


                if not condition_songs:
                    category_name = condition_key.replace('_', ' ').title()
                    for query in self.therapeutic_queries[condition_key][:5]:
                        fallback_song = {
                            "title": f"Therapeutic Music for {category_name}",
                            "description": f"Recommended therapeutic music for {category_name.lower()}. Please search for this music on your preferred platform.",
                            "fallback": True
                        }
                        condition_songs.append(fallback_song)
                    condition_queries_used = [self.therapeutic_queries[condition_key][0]]


                category_name = condition_key.replace('_', ' ').title()
                recommendations["categories"][condition_key] = {
                    "query": condition_queries_used[0] if condition_queries_used else "",
                    "songs": condition_songs[:5],
                    "count": len(condition_songs[:5]),
                    "condition": condition_key
                }
                print(f" {category_name}: {len(condition_songs[:5])} songs added")
            else:

                print(f" {condition_key.replace('_', ' ').title()}: False - no songs suggested")


        if big5_scores:
            print(f"🎭 Starting Personality-Based recommendations...")
            personality_target = 10
            personality_entries = self.personality_mapping.get_genres_for_personality(big5_scores)
            personality_songs: List[Dict[str, Any]] = []
            personality_queries: List[str] = []
            personality_song_ids: Set[str] = set()
            personality_display_genres = [entry["genre"] for entry in personality_entries][:5]
            personality_refresh_required = bool(patient_info.get("_big5_changed"))
            historical_personality_ids: Set[str] = set()
            if personality_refresh_required:
                seen_ids = patient_info.get("_seen_personality_song_ids") or []
                historical_personality_ids = {
                    str(item).strip()
                    for item in seen_ids
                    if str(item).strip()
                }

            if not personality_entries:
                print(f" No personality genres returned!")
            else:
                print(f" Got {len(personality_entries)} personality genre entries")

            def add_personality_song(song: Dict[str, Any], trait: Optional[str] = None) -> bool:
                key = song.get("id") or song.get("title")
                if not key:
                    key = f"fallback::{len(personality_songs)}::{random.random()}"
                key = str(key)
                if personality_refresh_required and key in historical_personality_ids:
                    return False
                if key in personality_song_ids:
                    return False
                personality_songs.append(song)
                personality_song_ids.add(key)
                if personality_refresh_required:
                    historical_personality_ids.add(key)
                if trait:
                    song.setdefault("metadata", {})["personality_trait"] = trait
                return True

            csv_provider = getattr(self.music_service, "_provider", None)

            trait_limits: Dict[str, int] = defaultdict(int)
            max_per_trait = 2

            if csv_provider and hasattr(csv_provider, "search_by_personality"):
                exclude_ids = set(historical_personality_ids) if historical_personality_ids else None
                csv_personality_matches = csv_provider.search_by_personality(
                    big5_scores,
                    max_results=personality_target,
                    exclude_ids=exclude_ids,
                )
                csv_personality_matches = self._personalize_csv_matches(csv_personality_matches or [], patient_unique_id)
                for match in csv_personality_matches or []:
                    if len(personality_songs) >= personality_target:
                        break
                    metadata = match.get("metadata") or {}
                    trait = metadata.get("personality_trait")
                    if trait and trait_limits[trait] >= max_per_trait:
                        continue
                    if add_personality_song(match, trait):
                        if trait:
                            trait_limits[trait] += 1
                if csv_personality_matches:
                    personality_queries.append("local_csv_personality")

            if len(personality_songs) < personality_target and csv_provider and hasattr(csv_provider, "search_by_personality"):
                exclude_ids = set(personality_song_ids) | set(historical_personality_ids)
                csv_topup_matches = csv_provider.search_by_personality(
                    big5_scores,
                    max_results=personality_target * 2,
                    exclude_ids=exclude_ids,
                )
                csv_topup_matches = self._personalize_csv_matches(csv_topup_matches or [], patient_unique_id)
                for match in csv_topup_matches or []:
                    if len(personality_songs) >= personality_target:
                        break
                    metadata = match.get("metadata") or {}
                    trait = metadata.get("personality_trait")
                    if trait and trait_limits[trait] >= max_per_trait + 1:
                        trait = None
                    if add_personality_song(match, trait):
                        if trait:
                            trait_limits[trait] += 1
                if csv_topup_matches:
                    personality_queries.append("local_csv_personality:topup")

            for entry in personality_entries:
                if len(personality_songs) >= personality_target:
                    break

                trait = entry["trait"]
                genre = entry["genre"]
                remaining_trait_slots = max_per_trait - trait_limits[trait]
                if remaining_trait_slots <= 0:
                    continue

                csv_added = False
                if csv_provider and hasattr(csv_provider, "search_by_genres"):
                    csv_matches = csv_provider.search_by_genres(
                        [genre],
                        max_results=remaining_trait_slots,
                        trait_filters=[entry],
                    )
                    csv_matches = self._personalize_csv_matches(csv_matches or [], patient_unique_id)
                    for match in csv_matches or []:
                        if len(personality_songs) >= personality_target or trait_limits[trait] >= max_per_trait:
                            break
                        if add_personality_song(match, trait):
                            trait_limits[trait] += 1
                            csv_added = True
                    if csv_added:
                        personality_queries.append(f"{genre} (local_csv)")
                        continue

                genre_query = f"{genre} song"
                songs = self.music_service.search_music(genre_query, max_results=remaining_trait_slots)
                if songs:
                    added_any = False
                    for song in songs:
                        if len(personality_songs) >= personality_target or trait_limits[trait] >= max_per_trait:
                            break
                        if add_personality_song(song, trait):
                            added_any = True
                            trait_limits[trait] += 1
                    if added_any:
                        personality_queries.append(f"{genre_query} ({trait})")
                        print(f" Personality genre: {genre_query} - {len(songs)} songs")
                else:
                    print(f"  No results for: {genre_query}")


            if len(personality_songs) < personality_target:
                proven_queries = [
                    "Piano song",
                    "Spring song",
                    "Rain song",
                ]

                for query in proven_queries:
                    if len(personality_songs) >= personality_target:
                        break

                    songs = self.music_service.search_music(query, max_results=personality_target - len(personality_songs))
                    if songs:
                        added_any = False
                        for song in songs:
                            if len(personality_songs) >= personality_target:
                                break
                            if add_personality_song(song):
                                added_any = True
                        if added_any:
                            personality_queries.append(query)
                            print(f" Fallback query: {query} - {len(songs)} songs")
                            break


            if len(personality_songs) == 0:
                print("  Using guaranteed fallback - generating genre-specific personality songs")
                personality_songs = []
                personality_queries = []
                personality_song_ids.clear()


                for entry in personality_entries[:5]:
                    genre = entry["genre"]
                    if len(personality_songs) >= personality_target:
                        break

                    genre_query = f"{genre} song"
                    print(f"🎵 Searching music provider for: {genre_query}")
                    api_songs = self.music_service.search_music(genre_query, max_results=1)

                    if api_songs:
                        if add_personality_song(api_songs[0], entry.get("trait")):
                            print(f"   Found: {api_songs[0]['title']}")
                    else:

                        add_personality_song({
                            "title": f"{genre} Music for {patient_info.get('name', 'Patient')} - Relaxing Melody",
                            "description": f"Personalized {genre} music therapy. Please search for this type of music on your preferred platform."
                        })
                        print(f"   Using fallback for: {genre}")

                    personality_queries.append(genre_query)

            if len(personality_songs) < personality_target:
                dominant_trait = max(big5_scores.items(), key=lambda item: item[1])[0]
                for idx in range(len(personality_songs), personality_target):
                    fallback_song = {
                        "title": f"{dominant_trait.title()} Personality Focus #{idx + 1}",
                        "description": "Placeholder suggestion—search for calming music aligned to this trait.",
                        "channel": "TheraMuse Placeholder",
                        "source": "personality_fallback",
                    }
                    add_personality_song(fallback_song, dominant_trait)
                personality_queries.append("personality_placeholder")

            if personality_songs:
                display_genres = personality_display_genres or ["Soft Alternative"]
                recommendations["categories"]["big5_scores_songs"] = {
                    "query": f"{display_genres[0]} song.",
                    "songs": personality_songs,
                    "count": len(personality_songs),
                    "personality_genres": display_genres
                }
                print(f" Big5 Scores Songs: {len(personality_songs)} songs generated from personality mapping")


        total_songs = sum(category["count"] for category in recommendations["categories"].values())
        recommendations["total_songs"] = total_songs
        recommendations["method"] = "dementia_therapy_v2.1"
        recommendations["generated_at"] = datetime.now().isoformat()
        print(f"\n Generated {total_songs} total recommendations for Dementia/Alzheimer's therapy")
        print(f"Categories: {list(recommendations['categories'].keys())}")
        print("="*60 + "\n")

        return make_json_safe(recommendations)


class DownSyndromeTherapy:


    def __init__(self):
        self.music_service = MusicSearchService()
        self.primary_queries = [
            "Theta (4–8 Hz) brainwave entrainment",
            "40 Hz Stimulation music",
            "432 Hz Music",
            "528 Hz Music",
            "40–60 BPM rhythm",
            "sensory integration music therapy",
            "relaxing music for autism children"
        ]


    def get_down_syndrome_recommendations(self, patient_info: Dict = None) -> Dict:


        print("\n" + "="*60)
        print(" Generating Down Syndrome Therapy Recommendations...")
        print("="*60)

        recommendations = {
            "patient_context": {
                "condition": "down_syndrome",
                "therapy_focus": "calming sensory music with theta waves and therapeutic frequencies"
            },
            "categories": {}
        }


        import time

        for i, query in enumerate(self.primary_queries, 1):
            print(f"🎵 [{i}/{len(self.primary_queries)}] Searching for: {query}")


            time.sleep(0.5)

            songs = self.music_service.search_music(query, max_results=5)


            if not songs:
                print(f"   No songs found, creating placeholder for: {query}")
                fallback_songs = []
                for j in range(5):
                    fallback_song = {
                        "title": f"Down Syndrome Therapy - {query} (Track {j+1})",
                        "description": f"Calming sensory music for Down Syndrome therapy. Based on {query}. Please search for this music on your preferred platform.",
                        "fallback": True
                    }
                    fallback_songs.append(fallback_song)
                songs = fallback_songs
                print(f"   Created {len(songs)} fallback songs")
            else:
                print(f"   Found {len(songs)} songs")


            category_name = self._create_down_syndrome_category_name(query)


            recommendations["categories"][category_name] = {
                "query": query,
                "songs": songs,
                "count": len(songs),
                "description": f"Down Syndrome therapy music: {query}",
                "category_type": "primary_query"
            }


        total_songs = sum(category["count"] for category in recommendations["categories"].values())
        recommendations["total_songs"] = total_songs
        recommendations["method"] = "down_syndrome_therapy_v2"
        recommendations["generated_at"] = datetime.now().isoformat()

        print(f"\n Generated {total_songs} total recommendations for Down Syndrome therapy")
        print(f" Focus: All primary Down Syndrome queries processed with guaranteed songs")
        print(f"Categories: {list(recommendations['categories'].keys())}")
        print("="*60 + "\n")

        return recommendations

    def _create_down_syndrome_category_name(self, query: str) -> str:


        category_name = query.lower()


        replacements = {
            "theta (4–8 hz) brainwave entrainment": "theta_brainwave_4_8hz",
            "40 hz stimulation music": "stimulation_40hz",
            "432 hz music": "432hz_healing",
            "528 hz music": "528hz_miracle",
            "40–60 bpm rhythm": "rhythm_40_60bpm",
            "sensory integration music therapy": "sensory_integration",
            "relaxing music for autism children": "autism_relaxing"
        }


        for old, new in replacements.items():
            if old.lower() in category_name:
                category_name = new
                break


        import re
        category_name = re.sub(r'[^a-z0-9_]', '_', category_name)

        category_name = re.sub(r'_+', '_', category_name)

        category_name = category_name.strip('_')

        return category_name


