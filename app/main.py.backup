        return category_name


class LinearThompsonSampling:


    def __init__(self, n_features: int = 20, alpha: float = 1.0, lambda_reg: float = 1.0):
        self.n_features = n_features
        self.alpha = alpha
        self.lambda_reg = lambda_reg


        self.B = np.identity(n_features) * lambda_reg
        self.mu = np.zeros(n_features)
        self.f = np.zeros(n_features)


        self.n_interactions = 0
        self.total_reward = 0.0

    def sample_theta(self) -> np.ndarray:

        try:
            B_inv = np.linalg.inv(self.B)
            self.mu = B_inv @ self.f
            theta_sample = np.random.multivariate_normal(self.mu, self.alpha * B_inv)
            return theta_sample
        except np.linalg.LinAlgError:
            return self.mu + np.random.randn(self.n_features) * 0.1

    def predict(self, context: np.ndarray, theta: np.ndarray = None) -> float:

        if theta is None:
            theta = self.mu
        return np.dot(theta, context)

    def update(self, context: np.ndarray, reward: float, decay_factor: float = 0.98):


        self.B *= decay_factor
        self.f *= decay_factor


        self.B += np.outer(context, context)
        self.f += reward * context

        self.n_interactions += 1
        self.total_reward += reward

    def get_average_reward(self) -> float:

        if self.n_interactions == 0:
            return 0.0
        return self.total_reward / self.n_interactions


class DatabaseManager:

    def __init__(self, database: Optional[str] = None):
        self.database = database or MYSQL_DATABASE
        self.conn = None
        self._table_columns_cache: Dict[str, Set[str]] = {}
        self._csv_fallback_cache: Optional[List[Dict[str, Any]]] = None
        self._csv_path = os.getenv(
            "NOSTALGIA_CSV_PATH",
            "/home/spectre-rosamund/CVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV/d.csv",
        )
        self._csv_warned_location = False
        self.connect()
        self.create_tables()

    def connect(self):
        if self.conn:
            try:
                self.conn.close()
            except mysql.connector.Error:
                pass
        self.conn = connect_to_mysql(self.database)
        self.conn.autocommit = False

    def create_tables(self):
        cursor = self.conn.cursor()

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS therapy_sessions (
                session_id VARCHAR(64) PRIMARY KEY,
                patient_id VARCHAR(64) NOT NULL,
                `condition` VARCHAR(64) NOT NULL,
                therapy_method VARCHAR(255),
                total_songs INT,
                exploration_rate DOUBLE,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_sessions_patient (patient_id),
                INDEX idx_sessions_condition (`condition`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS therapy_recommendations (
                id INT AUTO_INCREMENT PRIMARY KEY,
                session_id VARCHAR(64) NOT NULL,
                patient_id VARCHAR(64) NOT NULL,
                category VARCHAR(255) NOT NULL,
                query TEXT,
                song_title VARCHAR(255),
                video_id VARCHAR(128),
                channel VARCHAR(255),
                description TEXT,
                `rank` INT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_recs_session (session_id),
                INDEX idx_recs_patient (patient_id),
                CONSTRAINT fk_recs_session FOREIGN KEY (session_id)
                    REFERENCES therapy_sessions(session_id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS therapy_feedback (
                id INT AUTO_INCREMENT PRIMARY KEY,
                patient_id VARCHAR(64) NOT NULL,
                session_id VARCHAR(64),
                `condition` VARCHAR(64) NOT NULL,
                song_title VARCHAR(255),
                video_id VARCHAR(128),
                reward DOUBLE NOT NULL,
                feedback_type VARCHAR(64),
                context_features TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_feedback_patient (patient_id),
                INDEX idx_feedback_session (session_id),
                INDEX idx_feedback_condition (`condition`),
                CONSTRAINT fk_feedback_session FOREIGN KEY (session_id)
                    REFERENCES therapy_sessions(session_id) ON DELETE SET NULL
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS bandit_stats (
                id INT AUTO_INCREMENT PRIMARY KEY,
                `condition` VARCHAR(64) NOT NULL,
                n_interactions INT,
                total_reward DOUBLE,
                avg_reward DOUBLE,
                exploration_rate DOUBLE,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_bandit_condition (`condition`)
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS patients (
                patient_id VARCHAR(64) PRIMARY KEY,
                name VARCHAR(255),
                age INT,
                birth_year INT,
                `condition` VARCHAR(64),
                patient_info TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS big5_scores (
                id INT AUTO_INCREMENT PRIMARY KEY,
                patient_id VARCHAR(64),
                session_id VARCHAR(64),
                openness DOUBLE,
                conscientiousness DOUBLE,
                extraversion DOUBLE,
                agreeableness DOUBLE,
                neuroticism DOUBLE,
                reinforcement_learning INT DEFAULT 0,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                INDEX idx_big5_patient (patient_id),
                INDEX idx_big5_session (session_id),
                CONSTRAINT fk_big5_patient FOREIGN KEY (patient_id)
                    REFERENCES patients(patient_id) ON DELETE SET NULL,
                CONSTRAINT fk_big5_session FOREIGN KEY (session_id)
                    REFERENCES therapy_sessions(session_id) ON DELETE SET NULL
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )

        self.conn.commit()
        cursor.close()

    def _parse_csv_release(self, raw_value: str) -> Optional[str]:
        raw_value = (raw_value or "").strip()
        if not raw_value:
            return None

        formats = [
            "%Y-%m-%d",
            "%m/%d/%Y",
            "%d/%m/%Y",
            "%Y/%m/%d",
            "%d-%m-%Y",
            "%Y",
        ]

        for fmt in formats:
            try:
                parsed = datetime.strptime(raw_value, fmt)
                if fmt == "%Y":
                    return f"{parsed.year}-01-01"
                return parsed.strftime("%Y-%m-%d")
            except ValueError:
                continue

        digits_only = "".join(ch for ch in raw_value if ch.isdigit())
        if len(digits_only) == 4:
            return f"{digits_only}-01-01"
        return None

    def _load_csv_fallback(self) -> List[Dict[str, Any]]:
        if self._csv_fallback_cache is not None:
            return self._csv_fallback_cache

        csv_path = (self._csv_path or "").strip()
        if not csv_path:
            self._csv_fallback_cache = []
            return self._csv_fallback_cache

        csv_file = Path(csv_path).expanduser()
        if not csv_file.exists():
            print(f"ℹ️  Nostalgia CSV fallback not found at {csv_file}")
            self._csv_fallback_cache = []
            return self._csv_fallback_cache

        dataset: List[Dict[str, Any]] = []
        seen: Set[Tuple[str, str]] = set()

        try:
            with csv_file.open(newline="", encoding="utf-8") as handle:
                reader = csv.DictReader(handle)
                for row in reader:
                    song_name = (row.get("song_name") or "").strip()
                    if not song_name:
                        continue

                    artist_name = (row.get("singer") or "").strip()
                    dedupe_key = (song_name.lower(), artist_name.lower())
                    if dedupe_key in seen:
                        continue
                    seen.add(dedupe_key)

                    release_value = self._parse_csv_release(row.get("released_date") or "")
                    release_year = None
                    if release_value:
                        try:
                            release_year = int(release_value[:4])
                        except ValueError:
                            release_year = None

                    dataset.append(
                        {
                            "song_name": song_name,
                            "artist_name": artist_name or None,
                            "release_value": release_value,
                            "release_year": release_year,
                            "genre": (row.get("genre") or "").strip() or None,
                            "language": (row.get("language") or "").strip() or None,
                        }
                    )

            print(f"ℹ️  Loaded {len(dataset)} fallback songs from CSV at {csv_file}")
        except Exception as exc:  # pragma: no cover - defensive fallback
            print(f"⚠️  Failed to load nostalgia CSV fallback: {exc}")
            dataset = []

        self._csv_fallback_cache = dataset
        return dataset

    def _get_csv_fallback_rows(
        self,
        city: Optional[str],
        start_year: Optional[int],
        end_year: Optional[int],
        limit: int,
    ) -> List[Dict]:
        dataset = self._load_csv_fallback()
        if not dataset:
            return []

        if city and not self._csv_warned_location:
            print("ℹ️  CSV fallback dataset lacks city metadata; returning general songs.")
            self._csv_warned_location = True

        results: List[Dict[str, Any]] = []
        start: Optional[int] = None
        end: Optional[int] = None
        if start_year is not None and end_year is not None:
            start, end = sorted([start_year, end_year])

        for row in dataset:
            release_year = row.get("release_year")
            if (
                start is not None
                and end is not None
                and release_year is not None
                and not (start <= release_year <= end)
            ):
                    continue

            results.append(
                {
                    "song_name": row.get("song_name"),
                    "artist_name": row.get("artist_name"),
                    "release_value": row.get("release_value"),
                    "genre": row.get("genre"),
                }
            )

            if len(results) >= limit:
                break

        return results

    def _table_exists(self, table: str) -> bool:
        cache_key = f"table_exists::{table}"
        if cache_key in self._table_columns_cache:
            return True

        cursor = self.conn.cursor()
        try:
            cursor.execute(
                """
                SELECT COUNT(*)
                FROM information_schema.tables
                WHERE table_schema = DATABASE() AND table_name = %s
                """,
                (table,),
            )
            exists = cursor.fetchone()[0] > 0
            if exists:
                self._table_columns_cache[cache_key] = set()
            return exists
        except mysql.connector.Error:
            return False
        finally:
            cursor.close()

    def _get_table_columns(self, table: str) -> Set[str]:
        if table in self._table_columns_cache:
            return self._table_columns_cache[table]

        if not self._table_exists(table):
            return set()

        cursor = self.conn.cursor()
        try:
            cursor.execute(f"SHOW COLUMNS FROM `{table}`")
            columns = {row[0] for row in cursor.fetchall()}
            self._table_columns_cache[table] = columns
            return columns
        except mysql.connector.Error:
            return set()
        finally:
            cursor.close()

    def get_songs_for_nostalgia_window(
        self,
        city: Optional[str],
        start_year: Optional[int],
        end_year: Optional[int],
        limit: int = 20,
    ) -> List[Dict]:
        fallback = lambda: self._get_csv_fallback_rows(city, start_year, end_year, limit)

        if not self._table_exists("songs"):
            return fallback()

        song_columns = self._get_table_columns("songs")
        if not song_columns:
            return fallback()

        select_parts = ["s.song_name AS song_name"]
        join_clause = ""
        singer_columns: Set[str] = set()

        if "singer_id" in song_columns and self._table_exists("singers"):
            singer_columns = self._get_table_columns("singers")
            select_parts.append("sg.singer_name AS artist_name")
            join_clause = "LEFT JOIN singers sg ON sg.singer_id = s.singer_id"
        elif "singer" in song_columns:
            select_parts.append("s.singer AS artist_name")
        else:
            select_parts.append("NULL AS artist_name")

        release_column = None
        release_year_column = None
        for candidate in ("released_date", "release_date"):
            if candidate in song_columns:
                release_column = candidate
                break
        if not release_column and "release_year" in song_columns:
            release_year_column = "release_year"

        if release_column:
            select_parts.append(f"s.{release_column} AS release_value")
        elif release_year_column:
            select_parts.append(f"s.{release_year_column} AS release_value")
        else:
            select_parts.append("NULL AS release_value")

        conditions = []
        params: List[Any] = []

        if start_year and end_year and (release_column or release_year_column):
            start, end = sorted([start_year, end_year])
            if release_column:
                conditions.append(f"s.{release_column} BETWEEN %s AND %s")
                params.extend([f"{start}-01-01", f"{end}-12-31"])
            else:
                conditions.append(f"s.{release_year_column} BETWEEN %s AND %s")
                params.extend([start, end])

        if city:
            city_filters = []
            like_value = f"%{city}%"
            for column in song_columns:
                if "city" in column.lower():
                    city_filters.append(f"s.`{column}` LIKE %s")
            for column in singer_columns:
                lowered = column.lower()
                if "city" in lowered or "hometown" in lowered or "birthplace" in lowered:
                    city_filters.append(f"sg.`{column}` LIKE %s")
            if city_filters:
                conditions.append("(" + " OR ".join(city_filters) + ")")
                params.extend([like_value] * len(city_filters))

        where_clause = ""
        if conditions:
            where_clause = "WHERE " + " AND ".join(conditions)

        order_clause = "s.song_name ASC"
        if release_column:
            order_clause = f"s.{release_column} DESC"
        elif release_year_column:
            order_clause = f"s.{release_year_column} DESC"

        query = f"""
            SELECT {", ".join(select_parts)}
            FROM songs s
            {join_clause}
            {where_clause}
            ORDER BY {order_clause}
            LIMIT %s
        """
        params.append(limit)

        cursor = self.conn.cursor(dictionary=True)
        try:
            cursor.execute(query, params)
            results = cursor.fetchall() or []
            if results:
                return results
        except mysql.connector.Error as exc:
            print(f"⚠️  Error fetching nostalgia songs: {exc}")
        finally:
            cursor.close()

        return fallback()

    def save_session(
        self,
        session_id: str,
        patient_id: str,
        condition: str,
        therapy_method: str,
        total_songs: int,
        exploration_rate: float,
    ):
        cursor = self.conn.cursor()
        cursor.execute(
            """
            INSERT INTO therapy_sessions (session_id, patient_id, `condition`, therapy_method, total_songs, exploration_rate)
            VALUES (%s, %s, %s, %s, %s, %s)
            ON DUPLICATE KEY UPDATE
                patient_id = VALUES(patient_id),
                `condition` = VALUES(`condition`),
                therapy_method = VALUES(therapy_method),
                total_songs = VALUES(total_songs),
                exploration_rate = VALUES(exploration_rate)
            """,
            (
                session_id,
                patient_id,
                condition,
                therapy_method,
                total_songs,
                exploration_rate,
            ),
        )
        self.conn.commit()
        cursor.close()

    def save_recommendations(self, session_id: str, patient_id: str, recommendations: Dict):
        cursor = self.conn.cursor()

        for category_name, category_data in recommendations.get("categories", {}).items():
            songs = category_data.get("songs", [])
            for rank, song in enumerate(songs, 1):
                video_id = None
                if isinstance(song.get("id"), dict):
                    video_id = song.get("id", {}).get("videoId")
                else:
                    video_id = song.get("id")

                cursor.execute(
                    """
                    INSERT INTO therapy_recommendations
                    (session_id, patient_id, category, query, song_title, video_id, channel, description, `rank`)
                    VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
                    """,
                    (
                        str(session_id),
                        str(patient_id),
                        str(category_name),
                        str(category_data.get("query", "")),
                        str(song.get("title", "")),
                        str(video_id) if video_id else None,
                        str(song.get("channel", "")),
                        str(song.get("description", ""))[:500],
                        int(rank),
                    ),
                )

        self.conn.commit()
        cursor.close()

    def save_feedback(
        self,
        patient_id: str,
        session_id: str,
        condition: str,
        song: Dict,
        reward: float,
        feedback_type: str,
        context_features: List[float],
    ):
        cursor = self.conn.cursor()

        video_id = None
        if isinstance(song.get("id"), dict):
            video_id = song.get("id", {}).get("videoId")
        else:
            video_id = song.get("id")

        cursor.execute(
            """
            INSERT INTO therapy_feedback
            (patient_id, session_id, `condition`, song_title, video_id, reward, feedback_type, context_features)
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
            """,
            (
                str(patient_id),
                str(session_id),
                str(condition),
                str(song.get("title", "")),
                str(video_id) if video_id else None,
                float(reward),
                str(feedback_type),
                json.dumps(context_features),
            ),
        )
        self.conn.commit()
        cursor.close()

    def save_patient(self, patient_id: str, patient_info: Dict):
        cursor = self.conn.cursor()
        cursor.execute(
            """
            INSERT INTO patients (patient_id, name, age, birth_year, `condition`, patient_info)
            VALUES (%s, %s, %s, %s, %s, %s)
            ON DUPLICATE KEY UPDATE
                name = VALUES(name),
                age = VALUES(age),
                birth_year = VALUES(birth_year),
                `condition` = VALUES(`condition`),
                patient_info = VALUES(patient_info)
            """,
            (
                patient_id,
                patient_info.get("name"),
                patient_info.get("age"),
                patient_info.get("birth_year"),
                patient_info.get("condition"),
                json.dumps(patient_info),
            ),
        )
        self.conn.commit()
        cursor.close()

    def save_big5_scores(self, session_id: str, patient_id: str, scores: Dict[str, Any]):
        if not scores:
            return
        cursor = self.conn.cursor()
        cursor.execute(
            """
            INSERT INTO big5_scores (
                patient_id, session_id, openness, conscientiousness, extraversion,
                agreeableness, neuroticism, reinforcement_learning
            )
            VALUES (%s, %s, %s, %s, %s, %s, %s, 0)
            """,
            (
                patient_id,
                session_id,
                float(scores.get("openness") or 0),
                float(scores.get("conscientiousness") or 0),
                float(scores.get("extraversion") or 0),
                float(scores.get("agreeableness") or 0),
                float(scores.get("neuroticism") or 0),
            ),
        )
        self.conn.commit()
        cursor.close()

    def get_latest_big5_scores(self, patient_id: str) -> Optional[Dict[str, Any]]:
        cursor = self.conn.cursor(dictionary=True)
        cursor.execute(
            """
            SELECT openness, conscientiousness, extraversion, agreeableness, neuroticism
            FROM big5_scores
            WHERE patient_id = %s
            ORDER BY created_at DESC
            LIMIT 1
            """,
            (patient_id,),
        )
        row = cursor.fetchone()
        cursor.close()
        return row

    def get_recent_personality_song_ids(self, patient_id: str, limit: int = 40) -> List[str]:
        limit_value = max(1, min(int(limit), 200))
        cursor = self.conn.cursor(dictionary=True)
        cursor.execute(
            f"""
            SELECT video_id, song_title, channel
            FROM therapy_recommendations
            WHERE patient_id = %s AND category = %s
            ORDER BY created_at DESC
            LIMIT {limit_value}
            """,
            (patient_id, "big5_scores_songs"),
        )
        rows = cursor.fetchall() or []
        cursor.close()

        seen_ids: List[str] = []
        for row in rows:
            video_id = row.get("video_id")
            if video_id:
                seen_ids.append(str(video_id))
                continue
            title = row.get("song_title") or ""
            channel = row.get("channel") or ""
            key = f"{title}::{channel}".strip(":")
            if key:
                seen_ids.append(key)
        return seen_ids

    def get_analytics(self) -> Dict:
        cursor = self.conn.cursor(dictionary=True)

        cursor.execute("SELECT COUNT(*) AS count FROM therapy_sessions")
        total_sessions = cursor.fetchone()["count"]

        cursor.execute("SELECT COUNT(*) AS count FROM therapy_feedback")
        total_feedback = cursor.fetchone()["count"]

        cursor.execute("SELECT COUNT(DISTINCT patient_id) AS count FROM patients")
        total_patients = cursor.fetchone()["count"]

        cursor.execute(
            """
            SELECT `condition` AS condition, AVG(reward) AS avg_reward, COUNT(*) AS count
            FROM therapy_feedback
            GROUP BY `condition`
            """
        )
        rewards_by_condition = cursor.fetchall()
        cursor.close()

        return {
            "total_sessions": total_sessions,
            "total_feedback": total_feedback,
            "total_patients": total_patients,
            "rewards_by_condition": rewards_by_condition,
        }

    def close(self):
        if self.conn:
            try:
                self.conn.close()
            except mysql.connector.Error:
                pass


class TheraMuse:

    def __init__(self, model_path: str = "theramuse_model.pkl", db_path: Optional[str] = None):

        print("\n" + "" * 30)
        print("Initializing TheraMuse v9.0 - Synchronized Build")
        print("" * 30 + "\n")

        self.model_path = model_path

        database_override = None
        if db_path:
            if db_path.endswith(".db"):
                print("⚠️  Legacy SQLite db_path detected; using configured MySQL database instead.")
            else:
                database_override = db_path

        self.db = DatabaseManager(database=database_override)


        self.dementia_therapy = DementiaTherapy(self.db)
        self.down_syndrome_therapy = DownSyndromeTherapy()
        self.adhd_therapy = ADHDTherapy()


        self.music_service = MusicSearchService()
        self._csv_provider: Optional[LocalMusicDataset] = getattr(self.music_service, "_provider", None)


        self.bandits = {
            "dementia": LinearThompsonSampling(),
            "down_syndrome": LinearThompsonSampling(),
            "adhd": LinearThompsonSampling()
        }


        self.exploration_rate = 0.3
        self.min_exploration_rate = 0.1


        self._load_model()

        print(" TheraMuse initialized successfully!\n")

    def _get_csv_provider(self) -> Optional[LocalMusicDataset]:
        if self._csv_provider:
            return self._csv_provider

        provider = getattr(self.music_service, "_provider", None)
        if provider:
            self._csv_provider = provider
            return provider

        therapy_services = [
            getattr(self, "dementia_therapy", None),
            getattr(self, "down_syndrome_therapy", None),
            getattr(self, "adhd_therapy", None),
        ]
        for therapy in therapy_services:
            service = getattr(therapy, "music_service", None)
            provider = getattr(service, "_provider", None)
            if provider:
                self._csv_provider = provider
                return provider
        return None

    def _attach_csv_preference_matches(self, recommendations: Dict, patient_info: Dict) -> None:
        provider = self._get_csv_provider()
        if not provider or not hasattr(provider, "search_by_patient_preferences"):
            return

        matches = provider.search_by_patient_preferences(patient_info, max_results=8)
        if not matches:
            return

        categories = recommendations.setdefault("categories", {})
        categories["patient_csv_matches"] = {
            "query": "local_csv_preferences",
            "songs": matches,
            "count": len(matches),
            "description": "Matches from curated CSV catalogue based on patient inputs",
        }
        recommendations["total_songs"] = (recommendations.get("total_songs") or 0) + len(matches)

    def _big5_scores_changed(self, previous: Optional[Dict[str, Any]], current: Optional[Dict[str, Any]], threshold: float = 0.3) -> bool:
        if not current:
            return False
        if not previous:
            return True
        traits = ("openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism")
        for trait in traits:
            prev_val = float(previous.get(trait) or 0)
            curr_val = float(current.get(trait) or 0)
            if abs(prev_val - curr_val) >= threshold:
                return True
        return False

    def extract_context_features(self, patient_info: Dict, condition: str) -> np.ndarray:


        features = np.zeros(20)


        condition_map = {"dementia": 0, "down_syndrome": 1, "adhd": 2}
        if condition in condition_map:
            features[condition_map[condition]] = 1.0


        if "age" in patient_info:
            features[4] = patient_info["age"] / 100.0


        if condition == "dementia":
            features[5] = float(patient_info.get("difficulty_sleeping", False))
            features[6] = float(patient_info.get("trouble_remembering", False))
            features[7] = float(patient_info.get("forgets_everyday_things", False))
            features[8] = float(patient_info.get("difficulty_recalling_old_memories", False))
            features[9] = float(patient_info.get("memory_worse_than_year_ago", False))


        if "big5_scores" in patient_info:
            big5 = patient_info["big5_scores"]
            features[10] = big5.get("openness", 4) / 7.0
            features[11] = big5.get("conscientiousness", 4) / 7.0
            features[12] = big5.get("extraversion", 4) / 7.0
            features[13] = big5.get("agreeableness", 4) / 7.0
            features[14] = big5.get("neuroticism", 4) / 7.0


        hour = datetime.now().hour
        features[15] = hour / 24.0


        if "instruments" in patient_info:
            features[16] = min(len(patient_info["instruments"]), 5) / 5.0
        if "natural_elements" in patient_info:
            features[17] = min(len(patient_info["natural_elements"]), 5) / 5.0

        return features

    def get_therapy_recommendations(self, patient_info: Dict, condition: str,
                                   patient_id: str = None) -> Dict:


        session_id = f"therapy_{datetime.now().strftime('%Y%m%d%H%M%S')}"


        big5_scores = patient_info.get("big5_scores")
        previous_big5 = None
        big5_changed = False
        seen_personality_ids: List[str] = []
        if patient_id and big5_scores:
            previous_big5 = self.db.get_latest_big5_scores(patient_id)
            big5_changed = self._big5_scores_changed(previous_big5, big5_scores)
            if big5_changed:
                seen_personality_ids = self.db.get_recent_personality_song_ids(patient_id, limit=50)


        if patient_id:
            self.db.save_patient(patient_id, patient_info)
            patient_info["_theramuse_patient_id"] = patient_id


        if big5_scores:
            patient_info["_big5_previous_scores"] = previous_big5
            patient_info["_big5_changed"] = big5_changed
            if big5_changed and seen_personality_ids:
                patient_info["_seen_personality_song_ids"] = seen_personality_ids


        if condition == "dementia":
            recommendations = self.dementia_therapy.get_dementia_recommendations(patient_info)
        elif condition == "down_syndrome":
            recommendations = self.down_syndrome_therapy.get_down_syndrome_recommendations(patient_info)
        elif condition == "adhd":
            recommendations = self.adhd_therapy.get_adhd_recommendations(patient_info)
        else:
            raise ValueError(f"Unknown condition: {condition}")

        self._attach_csv_preference_matches(recommendations, patient_info)

        bandit = self.bandits[condition]
        recommendations["bandit_stats"] = {
            "n_interactions": bandit.n_interactions,
            "avg_reward": bandit.get_average_reward(),
            "exploration_rate": self.exploration_rate
        }


        recommendations["session_id"] = session_id
        recommendations["patient_id"] = patient_id
        recommendations["condition"] = condition


        if patient_id:
            self.db.save_session(
                session_id, patient_id, condition,
                recommendations["method"], recommendations["total_songs"],
                self.exploration_rate
            )
            self.db.save_recommendations(session_id, patient_id, recommendations)
            if big5_scores:
                self.db.save_big5_scores(session_id, patient_id, big5_scores)


        try:
            self._export_recommendations_json(recommendations)
        except Exception as e:

            print(f"  Failed to export recommendations JSON: {e}")

        return recommendations

    def _export_recommendations_json(self, recommendations: Dict) -> Optional[Path]:


        base_dir = Path(__file__).resolve().parent

        data_dir = base_dir / "data"
        data_dir.mkdir(parents=True, exist_ok=True)

        condition = recommendations.get("condition", "unknown")
        ts = datetime.now().strftime("%Y%m%d%H%M%S")
        day = datetime.now().strftime("%Y%m%d")
        fname = f"theramuse_recommendations_{condition}_{ts}_{day}.json"
        fpath = data_dir / fname


        if "generated_at" not in recommendations:
            recommendations["generated_at"] = datetime.now().isoformat()

        safe_payload = make_json_safe(recommendations)
        try:
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(safe_payload, f, ensure_ascii=False, indent=2)

            print(f" Exported recommendations JSON → {fpath}")
            return fpath
        except PermissionError:

            import os
            cwd = Path(os.getcwd())
            fpath = cwd / fname
            with open(fpath, "w", encoding="utf-8") as f:
                json.dump(safe_payload, f, ensure_ascii=False, indent=2)
            print(f" Exported recommendations JSON (fallback) → {fpath}")
            return fpath

    def record_feedback(self, patient_id: str, session_id: str, condition: str,
                       song: Dict, feedback_type: str, patient_info: Dict = None):


        reward_map = {"like": 1.0, "neutral": 0.0, "dislike": -1.0, "skip": -0.5, "inappropriate": -1.0}
        reward = reward_map.get(feedback_type.lower(), 0.0)


        if patient_info:
            context = self.extract_context_features(patient_info, condition)
        else:
            context = np.zeros(20)


        self.bandits[condition].update(context, reward)


        self.db.save_feedback(
            patient_id, session_id, condition, song, reward,
            feedback_type, context.tolist()
        )


        self._update_reinforcement_learning_count(patient_id, session_id, feedback_type)


        bandit = self.bandits[condition]
        cursor = self.db.conn.cursor()
        cursor.execute(
            """
            INSERT INTO bandit_stats (`condition`, n_interactions, total_reward, avg_reward, exploration_rate)
            VALUES (%s, %s, %s, %s, %s)
            """,
            (
                condition,
                bandit.n_interactions,
                bandit.total_reward,
                bandit.get_average_reward(),
                self.exploration_rate,
            ),
        )
        self.db.conn.commit()
        cursor.close()


        if bandit.n_interactions > 50:
            self.exploration_rate = max(
                self.min_exploration_rate,
                self.exploration_rate * (50 / bandit.n_interactions)
            )

        print(f" Enhanced Feedback Recorded: {feedback_type} (reward={reward:.2f}), total interactions: {bandit.n_interactions}")

    def _update_reinforcement_learning_count(
        self, patient_id: str, session_id: str, feedback_type: str
    ):

        try:
            cursor = self.db.conn.cursor()
            cursor.execute(
                """
                SELECT id, reinforcement_learning
                FROM big5_scores
                WHERE patient_id = %s AND session_id = %s
                ORDER BY created_at DESC
                LIMIT 1
                """,
                (patient_id, session_id),
            )

            result = cursor.fetchone()
            if not result:
                cursor.close()
                return

            record_id, current_count = result
            current_count = current_count or 0

            increment = 1
            if feedback_type.lower() == "like":
                increment = 2

            new_count = current_count + increment

            cursor.execute(
                "UPDATE big5_scores SET reinforcement_learning = %s WHERE id = %s",
                (new_count, record_id),
            )
            self.db.conn.commit()
            cursor.close()

            print(f"  Reinforcement Learning Updated: Patient {patient_id}, Session {session_id}")
            print(f"  Feedback Type: {feedback_type}, Increment: {increment}, New Total: {new_count}")

        except mysql.connector.Error as e:
            print(f"  Database error updating reinforcement learning: {e}")
        except Exception as e:
            print(f"  Error updating reinforcement learning: {e}")

    def get_reinforcement_learning_stats(self, patient_id: str = None) -> Dict:

        try:
            cursor = self.db.conn.cursor(dictionary=True)

            if patient_id:
                cursor.execute(
                    """
                    SELECT patient_id, session_id, reinforcement_learning,
                           openness, conscientiousness, extraversion, agreeableness, neuroticism,
                           created_at
                    FROM big5_scores
                    WHERE patient_id = %s
                    ORDER BY created_at DESC
                    """,
                    (patient_id,),
                )
            else:
                cursor.execute(
                    """
                    SELECT patient_id, session_id, reinforcement_learning,
                           openness, conscientiousness, extraversion, agreeableness, neuroticism,
                           created_at
                    FROM big5_scores
                    WHERE reinforcement_learning > 0
                    ORDER BY reinforcement_learning DESC, created_at DESC
                    LIMIT 50
                    """
                )

            results = cursor.fetchall()
            cursor.close()

            stats = []
            for row in results:
                stats.append(
                    {
                        "patient_id": row["patient_id"],
                        "session_id": row["session_id"],
                        "reinforcement_learning_count": row["reinforcement_learning"],
                        "openness": row["openness"],
                        "conscientiousness": row["conscientiousness"],
                        "extraversion": row["extraversion"],
                        "agreeableness": row["agreeableness"],
                        "neuroticism": row["neuroticism"],
                        "created_at": row["created_at"],
                    }
                )

            return {
                "reinforcement_learning_stats": stats,
                "total_patients_with_rl": len({s["patient_id"] for s in stats}),
                "total_feedback_interactions": sum(
                    s["reinforcement_learning_count"] for s in stats
                ),
            }

        except mysql.connector.Error as e:
            print(f"Error getting reinforcement learning stats: {e}")
            return {
                "reinforcement_learning_stats": [],
                "total_patients_with_rl": 0,
                "total_feedback_interactions": 0,
            }

    def get_analytics(self) -> Dict:

        return self.db.get_analytics()

    def _load_model(self):

        try:
            if Path(self.model_path).exists():
                with open(self.model_path, "rb") as f:
                    model_data = pickle.load(f)

                    if "bandits" in model_data:
                        self.bandits = model_data["bandits"]
                    if "exploration_rate" in model_data:
                        self.exploration_rate = model_data["exploration_rate"]
                print(f" Model loaded from {self.model_path}")
        except Exception as e:
            print(f"ℹ  No existing model found. Starting fresh.")

    def _save_model(self):

        try:
            model_data = {
                "bandits": self.bandits,
                "exploration_rate": self.exploration_rate,
                "saved_at": datetime.now().isoformat()
            }
            with open(self.model_path, "wb") as f:
                pickle.dump(model_data, f)
            print(f" Model saved to {self.model_path}")
        except Exception as e:
            print(f"  Error saving model: {e}")

    def clear_music_cache(self):

        if hasattr(self, 'music_service'):
            self.music_service.clear_cache()
            print(" Music recommendation cache cleared for fresh recommendations")

    def get_music_cache_status(self) -> Dict:

        if hasattr(self, 'music_service'):
            return {
                "cache_size": self.music_service.get_cache_size(),
                "query_history_size": len(self.music_service._query_history)
            }
        return {"cache_size": 0, "query_history_size": 0}

    def check_api_health(self) -> Dict:

        health_status = {
            "timestamp": datetime.now().isoformat(),
            "music_service": self.music_service.get_api_health_status(),
            "query_generator": {
                "status": "static",
                "provider": "BangladeshiSingerQueryGenerator"
            },
            "database": self._check_database_health()
        }
        return health_status

    def _check_database_health(self) -> Dict:

        try:
            cursor = self.db.conn.cursor()
            cursor.execute("SELECT COUNT(*) FROM therapy_sessions")
            session_count = cursor.fetchone()[0]

            cursor.execute("SELECT COUNT(*) FROM therapy_recommendations")
            rec_count = cursor.fetchone()[0]

            return {
                "status": "healthy",
                "sessions_count": session_count,
                "recommendations_count": rec_count
            }
        except Exception as e:
            return {
                "status": "error",
                "error": str(e)[:100]
            }

    def close(self):

        self._save_model()
        self.db.close()
        print(" TheraMuse closed successfully")


class TheraMuseHTTPRequestHandler(BaseHTTPRequestHandler):
    """Simple HTTP request handler for TheraMuse API"""

    def __init__(self, *args, theramuse_instance=None, **kwargs):
        self.theramuse = theramuse_instance
        super().__init__(*args, **kwargs)

    def do_GET(self):
        """Handle GET requests"""
        if self.path == '/':
            self.send_response(200)
            self.send_header('Content-type', 'text/html')
            self.end_headers()
            response = """
            <html>
            <head><title>TheraMuse Backend</title></head>
            <body>
                <h1>TheraMuse Backend Server</h1>
                <p>Music therapy recommendation system is running!</p>
                <p>Available endpoints:</p>
                <ul>
                    <li>GET / - Status page</li>
                    <li>GET /health - Health check</li>
                </ul>
            </body>
            </html>
            """
            self.wfile.write(response.encode('utf-8'))

        elif self.path == '/health':
            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            health_data = {
                "status": "healthy",
                "service": "TheraMuse Backend",
                "timestamp": datetime.now().isoformat()
            }
            self.wfile.write(json.dumps(health_data).encode('utf-8'))

        else:
            self.send_response(404)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            error_response = {"error": "Endpoint not found"}
            self.wfile.write(json.dumps(error_response).encode('utf-8'))

    def do_POST(self):
        """Handle POST requests"""
        content_length = int(self.headers['Content-Length'])
        post_data = self.rfile.read(content_length)

        try:
            data = json.loads(post_data.decode('utf-8'))
        except json.JSONDecodeError:
            self.send_response(400)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            error_response = {"error": "Invalid JSON"}
            self.wfile.write(json.dumps(error_response).encode('utf-8'))
            return

        if self.path == '/recommend' and self.theramuse:
            try:
                patient_data = data.get('patient', {})
                therapy_type = data.get('therapy_type', 'dementia')
                patient_id = data.get('patient_id', 'unknown')

                recommendations = self.theramuse.get_therapy_recommendations(
                    patient_data, therapy_type, patient_id
                )

                self.send_response(200)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                response_data = make_json_safe(recommendations)
                self.wfile.write(json.dumps(response_data).encode('utf-8'))

            except Exception as e:
                self.send_response(500)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                error_response = {"error": f"Internal server error: {str(e)}"}
                self.wfile.write(json.dumps(error_response).encode('utf-8'))
        else:
            self.send_response(404)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            error_response = {"error": "Endpoint not found"}
            self.wfile.write(json.dumps(error_response).encode('utf-8'))

    def log_message(self, format, *args):
        """Custom log messages"""
        print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {format %args}")


def run_server(host='localhost', port=8000, theramuse_instance=None):
    """Run the HTTP server on specified host and port"""
    handler = lambda *args, **kwargs: TheraMuseHTTPRequestHandler(*args, theramuse_instance=theramuse_instance, **kwargs)

    server = HTTPServer((host, port), handler)
    print(f"🚀 TheraMuse server starting on http://{host}:{port}")
    print(f"   Access the API at http://{host}:{port}")
    print(f"   Health check: http://{host}:{port}/health")
    print("   Press Ctrl+C to stop the server")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n⏹️  Server is shutting down...")
        server.shutdown()
        print("✅ Server stopped successfully")


if __name__ == "__main__":

    # Parse command line arguments
    parser = argparse.ArgumentParser(description='TheraMuse Music Therapy Backend')
    parser.add_argument('--host', default='localhost', help='Host to bind the server to (default: localhost)')
    parser.add_argument('--port', type=int, default=8000, help='Port to bind the server to (default: 8000)')
    parser.add_argument('--test', action='store_true', help='Run therapy function tests instead of starting server')

    args = parser.parse_args()

    # Initialize TheraMuse instance
    theramuse = TheraMuse()

    # Run tests if requested
    if args.test:
        print(" Testing TheraMuse Therapy Functions...")

        print("\n" + "="*50)
        print("TESTING DEMENTIA THERAPY")
        print("="*50)

        dementia_patient = {
            "name": "Test Dementia Patient",
            "age": 75,
            "birth_year": 1948,
            "birthplace_country": "Bangladesh",
            "birthplace_city": "Dhaka",
            "instruments": ["Piano", "Guitar"],
            "favorite_season": "winter",
            "natural_elements": ["Rain", "Forest"],
            "difficulty_sleeping": True,
            "trouble_remembering": True,
            "big5_scores": {"openness": 4, "conscientiousness": 5, "extraversion": 3, "agreeableness": 6, "neuroticism": 2}
        }

        dementia_recs = theramuse.get_therapy_recommendations(dementia_patient, "dementia", "test_dementia")
        print(f"Dementia recommendations: {dementia_recs['total_songs']} songs")


        print("\n" + "="*50)
        print("TESTING DOWN SYNDROME THERAPY")
        print("="*50)

        down_syndrome_recs = theramuse.get_therapy_recommendations({"name": "Test Child"}, "down_syndrome", "test_down_syndrome")
        print(f"Down Syndrome recommendations: {down_syndrome_recs['total_songs']} songs")


        print("\n" + "="*50)
        print("TESTING ADHD THERAPY")
        print("="*50)

        adhd_recs = theramuse.get_therapy_recommendations({"name": "Test ADHD"}, "adhd", "test_adhd")
        print(f"ADHD recommendations: {adhd_recs['total_songs']} songs")


        if dementia_recs["categories"]:
            first_category = list(dementia_recs["categories"].keys())[0]
            songs = dementia_recs["categories"][first_category]["songs"]
            if songs:
                test_song = songs[0]
                theramuse.record_feedback(
                    "test_dementia", dementia_recs["session_id"],
                    "dementia", test_song, "like", dementia_patient
                )

        theramuse.close()
        print("\n All therapy functions tested successfully!")
    else:
        # Run server mode
        print("🎵 Starting TheraMuse Backend Server...")
        print(f"   Host: {args.host}")
        print(f"   Port: {args.port}")
        print("   Mode: Server")
        print()

        try:
            run_server(host=args.host, port=args.port, theramuse_instance=theramuse)
        except KeyboardInterrupt:
            print("\n⏹️  Shutting down server...")
        except Exception as e:
            print(f"\n❌ Server error: {e}")
        finally:
            theramuse.close()
