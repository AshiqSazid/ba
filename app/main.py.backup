                "songs": city_songs,
                "count": len(city_songs),
                "song_recommendations": (
                    city_song_recommendations
                    if len(city_song_recommendations) > 1
                    else (city_song_recommendations[0] if city_song_recommendations else "")
                ),
                "query_source": city_query_recommendations.get("source", "csv_database")
            }


        if instruments:
            instrument_target = 10
            instrument_songs: List[Dict] = []
            instrument_queries: List[str] = []
            existing_instrument_ids: Set[str] = set()

            for instrument in instruments[:5]:
                query = f"{instrument} song"
                added = self._fetch_songs_for_query(
                    query,
                    instrument_songs,
                    instrument_target,
                    f" Instrument ({instrument})"
                )
                if added:
                    instrument_queries.append(query)
                    existing_instrument_ids.update(
                        str(song.get("id") or song.get("title")) for song in instrument_songs if (song.get("id") or song.get("title"))
                    )
                if len(instrument_songs) >= instrument_target:
                    break

            if len(instrument_songs) < instrument_target:
                csv_provider = getattr(self.music_service, "_provider", None)
                if csv_provider and hasattr(csv_provider, "search_by_patient_preferences"):
                    csv_profile = {
                        "instruments": instruments,
