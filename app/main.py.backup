class LocalMusicDataset:
    """
    Offline music catalogue that loads rows from a curated CSV file and enables
    fuzzy matching against song titles, singers, languages, and genres.
    """

    AUDIO_FEATURE_FIELDS = {
        "danceability": "danceability",
        "acousticness": "acousticness",
        "energy": "energy",
        "liveness": "liveness",
        "loudness": "loudness",
        "speechiness": "speechiness",
        "tempo": "tempo",
    }

    PERSONALITY_FIELDS: Dict[str, Tuple[str, ...]] = {
        "openness": ("openness", "Openness"),
        "conscientiousness": ("conscientiousness", "Conscientiousness"),
        "extraversion": ("extraversion", "Extraversion"),
        "agreeableness": ("agreeableness", "Agreeableness"),
        "neuroticism": ("neuroticism", "Neuroticism"),
    }

    def __init__(self, csv_path: Optional[str] = None):
        self.csv_path = Path(
            csv_path
            or os.getenv(
                "LOCAL_MUSIC_CSV_PATH",
                "/home/spectre-rosamund/CVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV/d.csv",
            )
        ).expanduser()
        self._catalog: List[Dict[str, Any]] = []
        self._load_catalog()

    def _parse_release_date(self, raw_value: str) -> Optional[str]:
        raw_value = (raw_value or "").strip()
        if not raw_value:
            return None

        formats = [
            "%Y-%m-%d",
            "%m/%d/%Y",
            "%d/%m/%Y",
            "%Y/%m/%d",
            "%d-%m-%Y",
            "%Y",
        ]
        for fmt in formats:
            try:
                parsed = datetime.strptime(raw_value, fmt)
                if fmt == "%Y":
                    return f"{parsed.year}-01-01"
                return parsed.strftime("%Y-%m-%d")
            except ValueError:
                continue

        digits_only = "".join(ch for ch in raw_value if ch.isdigit())
        if len(digits_only) == 4:
            return f"{digits_only}-01-01"
        return None

    def _parse_duration_ms(self, raw_value: str) -> Optional[int]:
        raw_value = (raw_value or "").strip()
        if not raw_value:
            return None
        if raw_value.isdigit():
            seconds = int(raw_value)
            return seconds * 1000

        parts = raw_value.split(":")
        if all(part.isdigit() for part in parts):
            parts = [int(part) for part in parts]
            if len(parts) == 3:
                hours, minutes, seconds = parts
                total_seconds = hours * 3600 + minutes * 60 + seconds
                return total_seconds * 1000
            if len(parts) == 2:
                minutes, seconds = parts
                total_seconds = minutes * 60 + seconds
                return total_seconds * 1000
        return None

    def _parse_float_value(self, value: Optional[str]) -> Optional[float]:
        if value is None:
            return None
        text = str(value).strip()
        if not text:
            return None
        text = text.replace("%", "")
        try:
            return float(text)
        except ValueError:
            return None

    def _extract_audio_features(self, row: Dict[str, Any]) -> Dict[str, float]:
        features: Dict[str, float] = {}
        for feature_key, column in self.AUDIO_FEATURE_FIELDS.items():
            raw_value = row.get(column)
            numeric = self._parse_float_value(raw_value)
            if numeric is None:
                continue
            if feature_key in {"danceability", "acousticness", "energy", "liveness", "speechiness"}:
                numeric = max(0.0, min(1.0, numeric))
            features[feature_key] = numeric
        return features

    def _extract_personality_vector(self, row: Dict[str, Any]) -> Optional[Dict[str, float]]:
        vector: Dict[str, float] = {}
        for trait, columns in self.PERSONALITY_FIELDS.items():
            value: Optional[float] = None
            for column in columns:
                if column in row and row[column] not in (None, ""):
                    numeric = self._parse_float_value(row[column])
                    if numeric is not None:
                        value = numeric
                        break
            if value is not None:
                vector[trait] = value
        return vector or None

    def _build_track_record(self, row: Dict[str, str]) -> Optional[Dict[str, Any]]:
        normalized_row = {
            key: (value.strip() if isinstance(value, str) else value)
            for key, value in row.items()
        }

        song_name = (normalized_row.get("song_name") or "").strip()
        singer = (normalized_row.get("singer") or "").strip() or "Unknown Artist"
        if not song_name:
            return None

        release_value = self._parse_release_date(normalized_row.get("released_date") or "")
        duration_ms = self._parse_duration_ms(normalized_row.get("duration") or "")
        genre = (normalized_row.get("genre") or "").strip()
        language = (normalized_row.get("language") or "").strip()

        track_id = f"local::{hash((song_name.lower(), singer.lower(), release_value or ''))}"

        audio_features = self._extract_audio_features(normalized_row)
        personality_vector = self._extract_personality_vector(normalized_row)

        track = {
            "id": track_id,
            "title": song_name,
            "name": song_name,
            "url": f"https://theramuse.local/{track_id}",
            "artists": [singer],
            "artist": singer,
            "album": genre or "Local Catalogue",
            "duration_ms": duration_ms,
            "duration": duration_ms,
            "language": language,
            "genre": genre,
            "popularity": 50,
            "explicit": False,
            "metadata": {
                "release_value": release_value,
                "source": "local_csv_catalog",
                "csv_row": normalized_row,
                "audio_features": audio_features,
                "personality_vector": personality_vector,
            },
        }

        searchable_text = " ".join(
            filter(
                None,
                [
                    song_name.lower(),
                    singer.lower(),
                    genre.lower() if genre else "",
                    language.lower() if language else "",
                ],
            )
        )

        return {
            "track": track,
            "search_text": searchable_text,
        }

    def _load_catalog(self) -> None:
        if not self.csv_path.exists():
            print(f"ℹ️  Local music CSV not found at {self.csv_path}")
            self._catalog = []
            return

        catalog: List[Dict[str, Any]] = []
        seen_ids: Set[str] = set()

        try:
            with self.csv_path.open(newline="", encoding="utf-8") as handle:
                reader = csv.DictReader(handle)
                for row in reader:
                    record = self._build_track_record(row)
                    if not record:
                        continue
                    track_id = record["track"]["id"]
                    if track_id in seen_ids:
                        continue
                    seen_ids.add(track_id)
                    catalog.append(record)

            print(f"ℹ️  Loaded {len(catalog)} songs from {self.csv_path}")
        except Exception as exc:
            print(f"⚠️  Failed to load local music CSV: {exc}")
            catalog = []

        self._catalog = catalog

    def search_tracks(self, query: str, max_results: int = 20) -> List[Dict]:
        if not query:
            return []
        query_lower = query.lower()
        terms = [term for term in re.split(r"\s+", query_lower) if term]

        if not self._catalog:
            return []

        matches: List[Tuple[int, Dict[str, Any]]] = []
        for record in self._catalog:
            text = record["search_text"]
            score = 0
            if query_lower in text:
                score += 5
            for term in terms:
                if term in text:
                    score += 1
            if score > 0:
                matches.append((score, record["track"]))

        if not matches:
            # fallback: return first N songs for deterministic behavior
            return [record["track"] for record in self._catalog[:max_results]]

        matches.sort(key=lambda item: item[0], reverse=True)
        return [track for _, track in matches[:max_results]]

    def _normalise_preference_values(self, raw_value: Any) -> List[str]:
        values: List[str] = []
        if isinstance(raw_value, list):
            for item in raw_value:
                if isinstance(item, str):
                    cleaned = item.strip()
                    if cleaned:
                        values.append(cleaned)
        elif isinstance(raw_value, str):
            parts = [raw_value]
            if "," in raw_value:
                parts = raw_value.split(",")
            for part in parts:
                cleaned = part.strip()
                if cleaned:
                    values.append(cleaned)
        return values

    def _split_csv_list(self, raw_value: Optional[str]) -> List[str]:
        if not raw_value:
            return []
        return [segment.strip() for segment in raw_value.split(",") if segment.strip()]

    def search_by_patient_preferences(self, patient_info: Dict[str, Any], max_results: int = 8) -> List[Dict[str, Any]]:
        if not patient_info or not self._catalog:
            return []

        favorite_genre_input = patient_info.get("favorite_genre") or patient_info.get("favoriteGenres")
        favorite_genres = self._normalise_preference_values(favorite_genre_input)
        instrument_preferences = self._normalise_preference_values(patient_info.get("instruments"))
        preferred_languages = self._normalise_preference_values(
            patient_info.get("preferred_languages") or patient_info.get("preferredLanguages")
        )
        favorite_musician = (patient_info.get("favorite_musician") or "").strip().lower()

        has_preferences = any([favorite_genres, instrument_preferences, preferred_languages, favorite_musician])
        if not has_preferences:
            return []

        genre_terms = [genre.lower() for genre in favorite_genres]
        instrument_terms = {instrument.lower() for instrument in instrument_preferences}
        language_terms = [language.lower() for language in preferred_languages]

        matches: List[Tuple[int, Dict[str, Any]]] = []
        for record in self._catalog:
            track = record["track"]
            metadata = track.get("metadata", {}) or {}
            csv_row = metadata.get("csv_row") or {}

            score = 0
            matched_instruments: List[str] = []
            matched_genre: Optional[str] = None
            matched_language: Optional[str] = None

            track_genre = (csv_row.get("genre") or track.get("genre") or "").lower()
            if genre_terms and track_genre:
                for genre in genre_terms:
                    if genre and genre in track_genre:
                        score += 4
                        matched_genre = genre
                        break

            csv_instruments = self._split_csv_list(csv_row.get("used instruments in the song"))
            if instrument_terms and csv_instruments:
                for instrument in csv_instruments:
                    if instrument.lower() in instrument_terms:
                        matched_instruments.append(instrument)
                if matched_instruments:
                    score += 3 * len(matched_instruments)

            track_language = (csv_row.get("language") or "").lower()
            if language_terms and track_language:
                for language in language_terms:
                    if language and language in track_language:
                        score += 2
                        matched_language = language
                        break

            artist_name = (track.get("artist") or "").lower()
            if favorite_musician and artist_name and favorite_musician in artist_name:
                score += 3

            if score <= 0:
                continue

            description_parts: List[str] = []
            if csv_row.get("genre"):
                description_parts.append(csv_row["genre"])
            if csv_row.get("language"):
                description_parts.append(csv_row["language"])
            if matched_instruments:
                description_parts.append(", ".join(matched_instruments))

            match_payload = {
                "id": track.get("id"),
                "title": track.get("title"),
                "url": track.get("url"),
                "artist": track.get("artist"),
                "channel": "Local CSV Catalogue",
                "description": " • ".join(description_parts) if description_parts else None,
                "metadata": {
                    "genre": csv_row.get("genre"),
                    "language": csv_row.get("language"),
                    "instruments": csv_instruments,
                    "release_value": metadata.get("release_value"),
                    "match_score": score,
                    "matched_genre": matched_genre,
                    "matched_instruments": matched_instruments,
                    "matched_language": matched_language,
                },
                "source": "local_csv_preferences",
            }
            matches.append((score, match_payload))

        if not matches:
            return []

        matches.sort(
            key=lambda item: (
                item[0],
                (item[1].get("metadata", {}).get("release_value") or ""),
            ),
            reverse=True,
        )

        return [payload for _, payload in matches[:max_results]]

    def _score_audio_preferences(
        self,
        audio_features: Dict[str, float],
        trait_filters: Optional[List[Dict[str, Any]]],
    ) -> float:
        if not audio_features or not trait_filters:
            return 0.0

        total_score = 0.0
        for entry in trait_filters:
            for preference in entry.get("audio_preferences") or []:
                key = preference.get("key")
                if not key:
                    continue
                value = audio_features.get(key)
                if value is None:
                    continue

                weight = float(preference.get("weight", 1.0))
                min_val = preference.get("min")
                max_val = preference.get("max")
                target = preference.get("target")
                tolerance = float(preference.get("tolerance", 0.1))

                if target is not None:
                    diff = abs(value - target)
                    contribution = weight * max(0.0, 1 - diff / max(tolerance, 1e-6))
                    total_score += contribution
                    continue

                satisfied = True
                if min_val is not None and value < min_val:
                    satisfied = False
                if max_val is not None and value > max_val:
                    satisfied = False

                if satisfied:
                    total_score += weight
                else:
                    total_score -= weight * 0.5

        return total_score

    def search_by_genres(
        self,
        genres: List[str],
        max_results: int = 10,
        trait_filters: Optional[List[Dict[str, Any]]] = None,
    ) -> List[Dict[str, Any]]:
        if not genres or not self._catalog:
            return []

        normalized_terms: List[str] = []
        for genre in genres:
            if not isinstance(genre, str):
                continue
            cleaned = genre.strip().lower()
            if not cleaned:
                continue
            if cleaned not in normalized_terms:
                normalized_terms.append(cleaned)
            for fragment in re.split(r'[^a-z0-9]+', cleaned):
                fragment = fragment.strip()
                if fragment and fragment not in normalized_terms:
                    normalized_terms.append(fragment)

        if not normalized_terms:
            return []

        matches: List[Tuple[float, Dict[str, Any]]] = []
        seen_ids: Set[str] = set()

        for record in self._catalog:
            track = record["track"]
            metadata = track.get("metadata", {}) or {}
            csv_row = metadata.get("csv_row") or {}
            audio_features = metadata.get("audio_features") or self._extract_audio_features(csv_row)
            track_genre = (csv_row.get("genre") or track.get("genre") or "").lower()
            if not track_genre:
                continue

            score: float = 0.0
            matched_terms: List[str] = []

            for term in normalized_terms:
                if term and term in track_genre:
                    matched_terms.append(term)
                    score += 4 if " " in term else 2

            if score <= 0:
                continue

            score += self._score_audio_preferences(audio_features, trait_filters)

            track_id = track.get("id") or track.get("title")
            if track_id in seen_ids:
                continue
            seen_ids.add(track_id)

            description_parts: List[str] = []
            if csv_row.get("genre"):
                description_parts.append(csv_row["genre"])
            if csv_row.get("language"):
                description_parts.append(csv_row["language"])

            matches.append(
                (
                    score,
                    {
                        "id": track.get("id"),
                        "title": track.get("title"),
                        "url": track.get("url"),
                        "artist": track.get("artist"),
                        "channel": "Local CSV Catalogue",
                        "description": " • ".join(description_parts) if description_parts else None,
                        "metadata": {
                            "genre": csv_row.get("genre"),
                            "language": csv_row.get("language"),
                            "instruments": self._split_csv_list(csv_row.get("used instruments in the song")),
                            "release_value": metadata.get("release_value"),
                            "matched_terms": matched_terms,
                            "match_score": score,
                            "audio_features": audio_features,
                        },
                        "source": "local_csv_personality",
                    },
                )
            )

        if not matches:
            return []

        matches.sort(key=lambda item: (item[0], item[1]["metadata"].get("release_value") or ""), reverse=True)
        return [payload for _, payload in matches[:max_results]]

    def search_by_personality(
        self,
        target_scores: Dict[str, float],
        max_results: int = 10,
        exclude_ids: Optional[Set[str]] = None,
    ) -> List[Dict[str, Any]]:
        if not target_scores or not self._catalog:
            return []

        trait_order = ("openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism")
        exclude_lookup = {str(item) for item in (exclude_ids or set()) if item}
        matches: List[Tuple[float, Dict[str, Any]]] = []
        seen_ids: Set[str] = set()

        for record in self._catalog:
            track = record["track"]
            metadata = track.get("metadata", {}) or {}
            vector = metadata.get("personality_vector")
            if not vector:
                continue

            comparisons: List[Tuple[str, float]] = []
            for trait in trait_order:
                target_value = target_scores.get(trait)
                vector_value = vector.get(trait) if isinstance(vector, dict) else None
                if target_value is not None and vector_value is not None:
                    delta = float(target_value) - float(vector_value)
                    comparisons.append((trait, delta))

            if len(comparisons) < 3:
                continue

            distance = math.sqrt(sum(delta * delta for _, delta in comparisons) / len(comparisons))
            dominant_trait = min(comparisons, key=lambda item: abs(item[1]))[0]

            track_id = str(track.get("id") or track.get("title") or f"csv::{len(matches)}")
            if track_id in exclude_lookup or track_id in seen_ids:
                continue
            seen_ids.add(track_id)

            csv_row = metadata.get("csv_row") or {}
            description_parts: List[str] = []
            if csv_row.get("genre"):
                description_parts.append(csv_row["genre"])
            if csv_row.get("language"):
                description_parts.append(csv_row["language"])

            match_payload = {
                "id": track.get("id"),
                "title": track.get("title"),
                "url": track.get("url"),
                "artist": track.get("artist"),
                "channel": "Local CSV Catalogue",
                "description": " • ".join(description_parts) if description_parts else None,
                "metadata": {
                    "personality_distance": distance,
                    "personality_trait": dominant_trait,
                    "personality_vector": vector,
                    "genre": csv_row.get("genre"),
                    "language": csv_row.get("language"),
                },
                "source": "local_csv_personality",
            }
            matches.append((distance, match_payload))

        if not matches:
            return []

        matches.sort(key=lambda item: item[0])
        return [payload for _, payload in matches[:max_results]]

    def get_api_health_status(self) -> Dict[str, Any]:
        return {
            "service": "LocalMusicDataset",
            "csv_path": str(self.csv_path),
            "catalog_size": len(self._catalog),
        }


class MusicSearchService:


    def __init__(self, fetcher: Optional[Callable[[str, int], List[Dict]]] = None):
        self._provider: Optional[LocalMusicDataset] = None

        if fetcher is None:
            provider = LocalMusicDataset()
            self._provider = provider
            fetcher = provider.search_tracks

        self.fetcher = fetcher
        self._song_cache: Set[str] = set()
        self._query_history: Dict[str, int] = {}
        if self.fetcher:
            if self._provider:
                print("🎵 Music search service initialized with local dataset provider")
            else:
                print("🎵 Music search service initialized with custom provider")
        else:
            print("🎵 Music search service running in placeholder mode (no external provider configured)")

    def _vary_query(self, base_query: str) -> str:

        if base_query not in self._query_history:
            self._query_history[base_query] = 0
        self._query_history[base_query] += 1
        usage_count = self._query_history[base_query]

        query_lower = base_query.lower()
        has_song = " song" in query_lower or query_lower.endswith(" song")
        has_music = " music" in query_lower or query_lower.endswith(" music")

        if has_song or has_music:
            variations = [
                base_query,
                f"{base_query} official",
                f"{base_query} album",
                f"{base_query} single",
                f"{base_query} track"
            ]
        else:
            variations = [
                f"{base_query} song",
                f"{base_query} music",
                f"{base_query} official",
                f"{base_query} album",
                f"{base_query} single"
            ]

        variation_index = (usage_count - 1) % len(variations)
        return variations[variation_index]

    def _is_valid_music_result(self, track: Dict) -> bool:

        if not track:
            return False

        name = track.get('name') or track.get('title') or ''
        if not name:
            return False

        duration_ms = track.get('duration_ms')
        if duration_ms and 0 < duration_ms < 30000:
            return False

        return True

    def _normalize_track(self, track: Dict) -> Dict:

        if not track:
            return {}

        artist_names = track.get('artists') or track.get('artist') or []
        if isinstance(artist_names, str):
            artist_names = [artist_names]

        if artist_names:
            primary_artist = artist_names[0]
        else:
            primary_artist = track.get('primary_artist', 'Unknown Artist')

        album = track.get('album') or {}
        if isinstance(album, str):
            album_name = album
            album_images = []
        else:
            album_name = album.get('name', 'Unknown Album')
            album_images = album.get('images', [])

        image_url = ''
        if isinstance(album_images, list) and album_images:
            first_image = album_images[0]
            if isinstance(first_image, dict):
                image_url = first_image.get('url', '')
            elif isinstance(first_image, str):
                image_url = first_image

        return {
            'id': track.get('id', ''),
            'title': track.get('title') or track.get('name', ''),
            'url': track.get('url', ''),
            'artist': primary_artist,
            'artists': artist_names,
            'album': album_name,
            'duration_ms': track.get('duration_ms', 0),
            'duration': track.get('duration', 0),
            'preview_url': track.get('preview_url', ''),
            'image_url': image_url,
            'popularity': track.get('popularity', 0),
            'explicit': track.get('explicit', False)
        }

    def search_music(self, query: str, max_results: int = 50, max_retries: int = 3) -> List[Dict]:


        varied_query = self._vary_query(query)

        if not self.fetcher:
            print(f" Music search placeholder: '{query}' → '{varied_query}' | No provider configured.")
            return []

        for attempt in range(max_retries):
            try:
                print(f" Query '{query}' → '{varied_query}' | Searching music provider (limit={max_results})")
                tracks = self.fetcher(varied_query, max_results) or []

                valid_tracks = []
                seen_track_ids: Set[str] = set()

                for track in tracks:
                    track_id = track.get('id')

                    if not track_id or track_id in self._song_cache or track_id in seen_track_ids:
                        continue

                    if not self._is_valid_music_result(track):
                        continue

                    normalized = self._normalize_track(track)
                    if normalized.get('id'):
                        valid_tracks.append(normalized)
                        seen_track_ids.add(normalized['id'])
                        self._song_cache.add(normalized['id'])

                print(f" Fetched {len(tracks)} tracks | Valid tracks {len(valid_tracks)}")

                if valid_tracks:
                    return valid_tracks

                if attempt < max_retries - 1:
                    time.sleep(1)

            except Exception as exc:
                print(f"Attempt {attempt + 1} failed: {exc}")
                if attempt < max_retries - 1:
                    time.sleep(2)
                    continue

        return []

    def get_track_metadata(
        self,
        song_title: str,
        artist_name: Optional[str] = None,
        max_results: int = 3
    ) -> Optional[Dict]:

        if not song_title:
            return None

        title = song_title.strip()
        artist = artist_name.strip() if artist_name else ""
        queries = []

        if title and artist:
            queries.append(f'{title} {artist}')
        if title:
            queries.append(title)

        seen_keys: Set[str] = set()

        provider_fetcher = self._provider.search_tracks if self._provider else None

        for query in queries:
            if provider_fetcher:
                results = provider_fetcher(query, max_results=max_results)
            else:
                results = self.search_music(query, max_results=max_results)

            if not results:
                continue

            for track in results:
                normalized = self._normalize_track(track)
                track_id = normalized.get("id")
                artist_label = normalized.get("artist")
                dedupe_key = track_id or f"{normalized.get('title')}::{artist_label}"

                if dedupe_key in seen_keys:
                    continue
                seen_keys.add(dedupe_key)

                if track_id and track_id in self._song_cache:
                    continue

                if track_id:
                    self._song_cache.add(track_id)

                normalized.setdefault("source", "theramuse_music_api")
                if artist and not normalized.get("artist"):
                    normalized["artist"] = artist
                return normalized

        return None

    def validate_location_relevance(self, track: Dict, location: str) -> bool:

        if not location or not track:
            return True

        location_lower = location.lower()
        title = (track.get('title') or track.get('name') or '').lower()
        artist = (track.get('artist') or '').lower()
        album = (track.get('album') or '').lower()

        location_in_title = location_lower in title
        location_in_artist = location_lower in artist
        location_in_album = location_lower in album

        if location_lower in ['bangladesh', 'bangla', 'bengali']:
            bengali_indicators = [
                'bangla', 'bengali', 'dhaka', 'bangladesh', 'বাংলা', 'ঢাকা',
                'bangla gaan', 'bengali song', 'bangla music', 'bangla folk',
                'bangla pop', 'bangla modern', 'bangla classic'
            ]
            bengali_artists = [
                'habib wahid', 'andrew kishore', 'runa laila', 'subir nandi',
                'mahmuduzzaman babu', 'firoz shai', 'abdul jabbar', 'farida mahmud',
                'shakila zafar', 'kumar biswajit', 'asif akbar', 'momtaz',
                'abed hadi', 'ferdaus wahid', 'tahsan', 'minen', 'shironamhin'
            ]

            has_bengali_content = any(
                indicator in title or indicator in artist or indicator in album
                for indicator in bengali_indicators
            )
            has_bengali_artist = any(artist_name in artist for artist_name in bengali_artists)

            return has_bengali_content or has_bengali_artist or location_in_title or location_in_artist or location_in_album
        else:
            regional_indicators = [
                location_lower,
                f"{location_lower} music",
                f"{location_lower} song",
                f"{location_lower} folk"
            ]
            has_regional_content = any(
                indicator in title or indicator in artist or indicator in album
                for indicator in regional_indicators
            )

            return has_regional_content or location_in_title or location_in_artist or location_in_album

    def clear_cache(self):
        self._song_cache.clear()
        self._query_history.clear()
        print(" Music search cache cleared")

    def get_cache_size(self):
        return len(self._song_cache)

    def get_api_health_status(self) -> Dict:

        status: Dict[str, Any] = {
            "api_status": "healthy" if self.fetcher else "unavailable",
            "service": "MusicSearchService"
        }
        if self._provider:
            status["provider"] = self._provider.get_api_health_status()
        return status



class BangladeshiSingerQueryGenerator:
    """Curated Bangladeshi artist query generator used for therapy recommendations."""

    REGION_KEYWORDS = {
        "dhaka": [
