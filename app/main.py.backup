                        "favorite_genre": patient_info.get("favorite_genre") or favorite_genres,
                        "favoriteGenres": favorite_genres if favorite_genres else None,
                    }
                    csv_matches = csv_provider.search_by_patient_preferences(
                        {key: value for key, value in csv_profile.items() if value},
                        max_results=instrument_target - len(instrument_songs),
                    )
                    if csv_matches:
                        for match in csv_matches:
                            if len(instrument_songs) >= instrument_target:
                                break
                            match_id = str(match.get("id") or match.get("title"))
                            if match_id in existing_instrument_ids:
                                continue
                            instrument_songs.append(match)
                            existing_instrument_ids.add(match_id)
                        if any(match.get("source") == "local_csv_preferences" for match in csv_matches):
                            instrument_queries.append("local_csv_preferences")

            recommendations["categories"]["instruments"] = {
                "query": instrument_queries if len(instrument_queries) > 1 else (instrument_queries[0] if instrument_queries else ""),
                "songs": instrument_songs,
